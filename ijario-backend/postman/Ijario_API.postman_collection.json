        },
        {
          "name": "Confirm / decline / cancel",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/viewings/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "viewings",
                "1"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"tasdiqlandi\"\n}"
            }
          }
        }
      ]
    },
