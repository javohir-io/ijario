                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"property_id\": 1,\n  \"scheduled_at\": \"2026-12-01T10:00:00Z\",\n  \"note\": \"Ikki kishi kelamiz\"\n}"
            }
          }
        },
        {
          "name": "My viewings",
          "request": {
            "method": "GET",
            "header": [],
