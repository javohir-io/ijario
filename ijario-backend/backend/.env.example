# Copy this file to .env and adjust as needed.
DATABASE_URL=postgresql+psycopg2://ijario:ijario_secret@db:5432/ijario
SECRET_KEY=please-change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
UPLOAD_DIR=uploads
BASE_URL=http://localhost:8000

# Approximate USD -> UZS rate. Used ONLY to sort/filter listings priced in
# different currencies (never shown as an exchange rate). Central Bank rate
# was ~12,000 in October 2026; refresh it now and then.
USD_TO_UZS=12000

# Optional — Cloudflare R2 object storage for uploads. Leave all four blank
# to keep using local disk storage (fine for local dev / docker-compose).
# Needed on hosts with no persistent disk (e.g. Render's free tier) so
# uploaded photos survive a restart.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
